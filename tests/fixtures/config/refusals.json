    },
    {
      "name": "a command id used twice",
      "base": "source-wide",
      "patch": [
        {
          "op": "replace",
          "path": "/commands/1/id",
          "value": "edit-project"
        }
      ]
    },
    {
      "name": "a command id outside the grammar",
      "base": "source-wide",
      "patch": [
        {
          "op": "replace",
          "path": "/commands/0/id",
          "value": "Edit Project"
        }
      ]
    },
    {
      "name": "an empty command id",
      "base": "source-wide",
      "patch": [
        {
          "op": "replace",
          "path": "/commands/0/id",
          "value": ""
        }
      ]
    },
    {
