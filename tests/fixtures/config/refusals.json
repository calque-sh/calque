  "accepted": [
    {
      "name": "a key-only collection whose command inserts and deletes with no writable column",
      "base": "source-wide",
      "patch": [
        {
          "op": "add",
          "path": "/collections/-",
          "value": {
            "id": "tags",
            "source": "serve-smoke",
            "kind": "table",
            "relation": {
              "schema": "public",
              "table": "tags"
            },
            "columns": [
              {
                "name": "task_id",
                "postgresType": "int8",
                "nullable": false
              },
              {
                "name": "label",
                "postgresType": "text",
                "nullable": false
              }
            ],
            "primaryKey": [
              "task_id",
              "label"
            ],
            "scope": "all",
            "adapter": "direct-columnar",
            "encoding": "calque-columnar"
          }
        },
        {
          "op": "add",
          "path": "/commands/-",
          "value": {
            "id": "edit-tags",
            "kind": "crud",
            "collection": "tags",
            "operations": [
              "insert",
              "delete"
            ],
            "writableColumns": []
          }
        }
      ]
    }
  ]
