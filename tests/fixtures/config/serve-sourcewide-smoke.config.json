{
  "application": { "id": "serve-smoke", "version": "0.1.0" },
  "protocol": {
    "manifest": 1,
    "artifact": 1,
    "changeStream": 1,
    "mutation": 1
  },
  "sources": [
    {
      "id": "serve-smoke",
      "databaseUrlEnv": "SERVE_SMOKE_DATABASE_URL",
      "publication": "calque_serve_smoke",
      "slot": "calque_serve_smoke_slot"
    }
  ],
  "scopes": [
    {
      "id": "all",
      "source": "serve-smoke",
      "kind": "source-wide",
      "dataVersion": 1
    }
  ],
  "collections": [
    {
      "id": "projects",
      "source": "serve-smoke",
      "kind": "table",
      "relation": { "schema": "public", "table": "projects" },
      "columns": [
        { "name": "id", "postgresType": "int8", "nullable": false },
        { "name": "name", "postgresType": "text", "nullable": false },
        { "name": "status", "postgresType": "text", "nullable": false }
      ],
      "primaryKey": ["id"],
      "scope": "all",
      "adapter": "direct-columnar",
      "encoding": "calque-columnar"
    },
    {
      "id": "tasks",
      "source": "serve-smoke",
      "kind": "table",
      "relation": { "schema": "public", "table": "tasks" },
      "columns": [
        { "name": "id", "postgresType": "int8", "nullable": false },
        { "name": "project_id", "postgresType": "int8", "nullable": false },
        { "name": "title", "postgresType": "text", "nullable": false },
        { "name": "done", "postgresType": "bool", "nullable": false }
      ],
      "primaryKey": ["id"],
      "scope": "all",
      "adapter": "direct-columnar",
      "encoding": "calque-columnar"
    }
  ],
  "commands": [
    {
      "id": "edit-project",
      "kind": "crud",
      "collection": "projects",
      "operations": ["update"],
      "writableColumns": ["name", "status"]
    },
    {
      "id": "edit-task",
      "kind": "crud",
      "collection": "tasks",
      "operations": ["insert", "update", "delete"],
      "writableColumns": ["project_id", "title", "done"]
    }
  ]
}
