.DS_Store
.env
.env.*
!.env.example
node_modules/
target/
dist/
coverage/
.generated-check-*/
.calque-dev/
.calque-local/
*.log
# Local review context packs, which duplicate the repository tree.
artifacts/
# Vitest browser-mode attachments (failure screenshots); regenerated by a run.
.vitest-attachments/
# Vitest browser-mode failure screenshots. Same reason: a run writes them,
# only a red run keeps them, and a committed one is debris from an
# intermediate failure rather than evidence any suite reproduces.
__screenshots__/

# Python bytecode. The clock-series analysis ships a `.py` that a reader runs;
# the interpreter's cache beside it is regenerated on every run and is not
# evidence.
__pycache__/
*.pyc

# Per-worktree Cargo target directories. Each concurrent worktree must build
# into its own, because a shared one lets one worktree's build satisfy another's
# freshness check, so following that rule produces one of these per checkout.
# `target/` above does not match it.
.cargo-target/

# What the README quickstart writes to the repository root. `grant-key.pk8` is
# the grant signing key: committed, it lets anyone mint grants the server
# accepts. The leading slash keeps the committed files of the same names under
# client/ tracked.
/grant-key.pk8
/grant.json
/caddy-root.crt
/calque.inspection.json
/calque.config.json
