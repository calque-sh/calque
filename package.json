{
  "name": "calque",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "demo": "exec node --import ./scripts/register.mjs scripts/demo.ts",
    "demo:change": "node --import ./scripts/register.mjs scripts/demo.ts change",
    "demo:e2e": "node --import ./scripts/register.mjs scripts/demo-restart-e2e.ts",
    "demo:e2e:cdc-restart": "node --import ./scripts/register.mjs scripts/demo-cdc-restart-e2e.ts",
    "demo:e2e:launcher": "node --import ./scripts/register.mjs scripts/demo-launcher-e2e.ts",
    "demo:e2e:image": "node --import ./scripts/register.mjs scripts/demo-image-e2e.ts",
    "demo:e2e:latency": "node --import ./scripts/register.mjs scripts/demo-latency-e2e.ts",
    "demo:e2e:mutation": "node --import ./scripts/register.mjs scripts/demo-mutation-e2e.ts",
    "demo:e2e:reload": "node --import ./scripts/register.mjs scripts/demo-reload-e2e.ts",
    "demo:e2e:resnapshot": "node --import ./scripts/register.mjs scripts/demo-resnapshot-e2e.ts",
    "demo:smoke": "node --import ./scripts/register.mjs scripts/demo-smoke.ts",
    "bench": "exec node --import ./scripts/register.mjs scripts/bench.ts",
    "bench:fetch-browser": "node --import ./scripts/register.mjs scripts/bench-fetch-browser.ts",
    "incidents": "exec node --import ./scripts/register.mjs scripts/incidents.ts",
    "record:incidents": "node --import ./scripts/register.mjs scripts/record-incidents.ts",
    "incidents:e2e": "node --import ./scripts/register.mjs scripts/incidents-e2e.ts",
    "test": "cargo test --workspace --all-targets && pnpm test:node && pnpm -r --if-present test",
    "test:node": "node scripts/run-node-tests.mjs",
    "format": "cargo fmt --all && pnpm format:harness && pnpm -r --if-present format",
    "format:harness": "prettier --write \"scripts/**/*.ts\" \"scripts/**/*.mjs\"",
    "lint": "cargo clippy --workspace --all-targets -- -D warnings && pnpm lint:rust-production && pnpm -r --if-present lint",
    "lint:rust-production": "cargo clippy --workspace --lib --bins -- -D clippy::unwrap_used -D clippy::panic -D clippy::todo -D clippy::unimplemented -D clippy::dbg_macro",
    "selfhost:e2e": "node --import ./scripts/register.mjs scripts/selfhost-compose-e2e.ts",
    "getting-started:e2e": "node --import ./scripts/register.mjs scripts/getting-started-e2e.ts",
    "quickstart:e2e": "node --import ./scripts/register.mjs scripts/quickstart-e2e.ts",
    "serve:e2e": "node --import ./scripts/register.mjs scripts/serve-mutation-e2e.ts && node --import ./scripts/register.mjs scripts/serve-revocation-e2e.ts && node --import ./scripts/register.mjs scripts/serve-tenants-e2e.ts",
    "serve:e2e:revocation": "node --import ./scripts/register.mjs scripts/serve-revocation-e2e.ts",
    "serve:e2e:tenants": "node --import ./scripts/register.mjs scripts/serve-tenants-e2e.ts",
    "verify:s3:minio": "sh server/crates/blob-store/tests/s3-emulator/run.sh",
    "verify": "node --import ./scripts/register.mjs scripts/verify-workspace.ts",
    "verify:source-only": "node --import ./scripts/register.mjs scripts/verify-workspace.ts --source-only",
    "verify:packed": "node --import ./scripts/register.mjs scripts/verify-packed-packages.ts",
    "publish:packages": "node --import ./scripts/register.mjs scripts/publish-packages.ts",
    "verify:credentials": "node --import ./scripts/register.mjs scripts/verify-no-credentials.ts",
    "typecheck:harness": "tsc -p scripts/tsconfig.json",
    "verify:probes": "node --import ./scripts/register.mjs scripts/verify-workspace-probes.ts"
  },
  "devDependencies": {
    "@calque/config": "workspace:*",
    "@calque/grant": "workspace:*",
    "@types/negotiator": "0.6.5",
    "@types/node": "24",
    "negotiator": "1.1.0",
    "oxc-transform": "0.147.0",
    "playwright": "1.61.1",
    "prettier": "3.9.5",
    "typescript": "7.0.2"
  }
}
