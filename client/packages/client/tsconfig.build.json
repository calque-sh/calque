// `noEmit: false` overrides the `noEmit: true` of the config this extends;
// without it `pnpm build` writes nothing and still exits 0.
// `src/vite.ts` runs in Node and builds with tsconfig.vite.json, so Node's
// types stay out of the browser code's program.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "types": []
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.fixture.ts", "src/vite.ts"]
}
