{
  "name": "@calque/quickstart",
  "version": "0.1.0",
  "description": "The README self-host quickstart's page: one live query over tasks, served at http://127.0.0.1:5173.",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/calque-sh/calque",
    "directory": "client/examples/quickstart"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "format": "prettier --write .",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "generate:bindings": "calque-bindings",
    "generate:bindings:check": "calque-bindings --check",
    "test": "vitest run",
    "typecheck": "../../../node_modules/.bin/tsc --noEmit"
  },
  "dependencies": {
    "@calque/client": "workspace:*"
  },
  "devDependencies": {
    "@calque/config": "workspace:*",
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "jiti": "2.7.0",
    "prettier": "3.9.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
